{
  "name": "flosum-branch-creator",
  "displayName": "Flosum Branch Creator",
  "description": "Sidebar for Flosum DevOps: staged/changes view, selective push, branch retrieve, auto-refresh and diff support",
  "version": "0.1.0",
  "publisher": "icarvagu",
  "author": "Igor Carvalho Guedes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icarvagu/flosum-branch-creator.git"
  },
  "bugs": {
    "url": "https://github.com/icarvagu/flosum-branch-creator/issues"
  },
  "homepage": "https://github.com/icarvagu/flosum-branch-creator#readme",
  "keywords": [
    "flosum",
    "salesforce",
    "devops",
    "branch",
    "sf",
    "sfdx"
  ],
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flosum-container",
          "title": "Flosum",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "flosum-container": [
        {
          "id": "flosum.branchView",
          "name": "Branch Creator",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "flosum.refreshView",
        "title": "Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flosum.refreshView",
          "when": "view == flosum.branchView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "test": "jest --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["utils.js"]
  },
  "type": "commonjs",
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
